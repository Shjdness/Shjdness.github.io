# Dated upstream build. Replace with its tested digest after the first launch.
RSSHUB_IMAGE=ghcr.io/diygod/rsshub:2026-09-24
RSSHUB_PORT=1200
RSSHUB_ACCESS_KEY=replace-with-a-long-random-value
TZ=Asia/Shanghai
CACHE_EXPIRE=3600
REQUEST_TIMEOUT=15000

# Optional platform credentials. Keep this file on the server only.
BILIBILI_COOKIE_1=
PIXIV_REFRESHTOKEN=
TWITTER_AUTH_TOKEN=

# Optional outbound proxy, for example http://127.0.0.1:7890.
PROXY_URI=
